# Kopieer dit bestand naar .env en vul aan waar nodig.
# Geen van deze keys is verplicht voor de standaard-flow (mempool.space + CoinGecko gratis tier).

# Optioneel: CoinGecko demo/pro API key voor hogere rate limits.
COINGECKO_API_KEY=

# Optioneel: alleen nodig als je de experimentele Blockchair-backend gebruikt.
BLOCKCHAIR_API_KEY=

# Netwerk/rate-limit instellingen (optioneel, hebben defaults).
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=5
COINGECKO_RPM=25
MEMPOOL_RPM=60
